// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 接口分类表
model Category {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50) /// 分类名称
  description String?  /// 分类描述（可选）
  apis        Api[]    /// 该分类下的接口列表
  createdAt   DateTime @default(now()) @map("created_at") /// 创建时间

  @@map("categories")
}

/// 接口表
model Api {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100) /// 接口名称
  description     String?   /// 接口描述（可选）
  path            String    @unique @db.VarChar(50) /// 接口路径（唯一）
  method          String    @default("GET") @db.VarChar(10) /// 请求方法
  exampleUrl      String?   @map("example_url") @db.Text /// 示例URL
  requestParams   Json?     @map("request_params") /// 请求参数（JSON格式）
  responseFormat  Json?     @map("response_format") /// 返回格式（JSON格式）
  isFeatured      Boolean   @default(false) @map("is_featured") /// 是否推荐
  categoryId      Int       /// 所属分类ID
  category        Category  @relation(fields: [categoryId], references: [id]) /// 关联分类
  stats           ApiStat[] /// 统计信息
  createdAt       DateTime  @default(now()) @map("created_at") /// 创建时间

  @@map("apis")
}

/// 接口访问统计表
model ApiStat {
  id         Int      @id @default(autoincrement())
  callCount  Int      @default(0) @map("call_count") /// 调用次数
  lastCalled DateTime? @map("last_called") /// 最后调用时间
  apiId      Int      /// 关联接口ID
  api        Api      @relation(fields: [apiId], references: [id]) /// 关联接口

  @@map("api_stats")
}
