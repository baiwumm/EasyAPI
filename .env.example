# 项目关键词（对齐站点实际内容；Google 已忽略此标签，供轻量参考）
NEXT_PUBLIC_APP_KEYWORDS = 'EasyAPI,免费API,在线工具,API聚合平台,开发者工具,每日一言API,随机图片API,二维码生成器,BMI计算器,身份证查询,IP归属地查询,条形码生成,随机头像,土味情话,歇后语大全,节假日查询,测试数据生成,开放接口'
